# Where the SQLite database lives. Use ":memory:" for throwaway runs.
DATABASE_URL=./data/merge.db
PORT=4000
# Change this in any real deployment.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# How often (seconds) the scheduler opens dispatch stages, expires flags and shifts, etc.
SCHEDULER_INTERVAL_SECONDS=60
LOG_LEVEL=info
# --- Uploaded files (compliance documents, decision 18) ---
# "local" keeps files on disk under FILE_STORAGE_DIR; "s3" expects an S3-compatible bucket (adapter in src/lib/storage.ts).
FILE_STORAGE=local
FILE_STORAGE_DIR=./data/files
# S3_BUCKET=merge-documents
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Where emailed links point (invitations, password resets).
WEB_URL=http://localhost:5173
# Leave SMTP_URL unset to print emails to the console. Any SMTP endpoint works, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Merge <no-reply@example.com>
